datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FREELANCER
  ASSISTANT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  PAYPAL
  CASH
  OTHER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  companyName   String?        @map("company_name")
  avatarUrl     String?        @map("avatar_url")
  role          Role           @default(FREELANCER)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  clients       Client[]
  leads         Lead[]
  projects      Project[]
  tasks         Task[]
  meetings      Meeting[]
  invoices      Invoice[]
  payments      Payment[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String
  email       String
  phone       String?
  address     String?      @db.Text
  companyName String?      @map("company_name")
  website     String?
  industry    String?
  taxId       String?      @map("tax_id")
  status      ClientStatus @default(ACTIVE)
  notes       String?      @db.Text
  isDeleted   Boolean      @default(false) @map("is_deleted")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]
  meetings Meeting[]
  invoices Invoice[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@map("clients")
}

model Lead {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  name           String
  email          String
  phone          String?
  companyName    String?    @map("company_name")
  estimatedValue Float?     @map("estimated_value")
  source         String?
  status         LeadStatus @default(NEW)
  notes          String?    @db.Text
  convertedToId  String?    @map("converted_to_id")
  isDeleted      Boolean    @default(false) @map("is_deleted")
  deletedAt      DateTime?  @map("deleted_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@map("leads")
}

model Project {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  clientId    String          @map("client_id")
  name        String
  description String?         @db.Text
  budget      Float?
  startDate   DateTime?       @map("start_date")
  deadline    DateTime?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  progress    Int             @default(0)
  isDeleted   Boolean         @default(false) @map("is_deleted")
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks    Task[]
  invoices Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@map("projects")
}

model Task {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  projectId   String          @map("project_id")
  title       String
  description String?         @db.Text
  dueDate     DateTime?       @map("due_date")
  priority    ProjectPriority @default(MEDIUM)
  status      TaskStatus      @default(TODO)
  isDeleted   Boolean         @default(false) @map("is_deleted")
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Meeting {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  title       String
  meetingDate DateTime  @map("meeting_date")
  platform    String?
  locationUrl String?   @map("location_url")
  notes       String?   @db.Text
  reminder    Boolean   @default(true)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([meetingDate])
  @@map("meetings")
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  clientId      String        @map("client_id")
  projectId     String?       @map("project_id")
  invoiceNumber String        @unique @map("invoice_number")
  amount        Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  totalAmount   Float         @map("total_amount")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(DRAFT)
  notes         String?       @db.Text
  isDeleted     Boolean       @default(false) @map("is_deleted")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  invoiceId     String        @map("invoice_id")
  amount        Float
  paymentMethod PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionId String?       @map("transaction_id")
  paidDate      DateTime      @default(now()) @map("paid_date")
  createdAt     DateTime      @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceId])
  @@map("payments")
}
